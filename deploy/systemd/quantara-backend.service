[Unit]
Description=Quantara Quant Platform - FastAPI Kernel & Quantitative Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/quantara/dpp/backend
ExecStart=/opt/quantara/dpp/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
