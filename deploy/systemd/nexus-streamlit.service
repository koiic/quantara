[Unit]
Description=Nexus Quant Platform - Streamlit Executive Dashboard & DRL Studio
After=network.target nexus-backend.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nexus/dpp/backend
ExecStart=/opt/nexus/dpp/backend/.venv/bin/streamlit run executive_dashboard.py --server.port 8501 --server.address 127.0.0.1 --server.baseUrlPath /streamlit --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
